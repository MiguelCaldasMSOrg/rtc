{
  "tasks": [
    {
      "args": [
        "compile",
        "--fqbn",
        "sandeepmistry:nRF5:BBCmicrobitV2",
        "--warnings",
        "all",
        "."
      ],
      "command": "arduino-cli",
      "group": {
        "isDefault": true,
        "kind": "build"
      },
      "label": "Arduino: Compile",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "type": "process"
    },
    {
      "args": [
        "compile",
        "--fqbn",
        "sandeepmistry:nRF5:BBCmicrobitV2",
        "--warnings",
        "all",
        "--upload",
        "--port",
        "${input:microbitPort}",
        "."
      ],
      "command": "arduino-cli",
      "label": "Arduino: Compile and Upload",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "type": "process"
    },
    {
      "args": [
        "compile",
        "--fqbn",
        "sandeepmistry:nRF5:BBCmicrobitV2",
        "--build-path",
        ".build",
        "--only-compilation-database",
        "."
      ],
      "command": "arduino-cli",
      "label": "Arduino: Refresh Compilation Database",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "type": "process"
    }
  ],
  "inputs": [
    {
      "default": "COM3",
      "description": "BBC micro:bit V2 USB serial port (for example, COM3)",
      "id": "microbitPort",
      "type": "promptString"
    }
  ],
  "version": "2.0.0"
}
